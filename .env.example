# Template for your local settings. Copy it once:
#   cp .env.example .env.local
# .env.local is git-ignored and holds your values; this file is committed, so it
# must never contain a real secret — only names, comments and safe defaults.

# Shown as the page title. The NEXT_PUBLIC_ prefix builds the value into the
# JavaScript sent to the browser, so anyone can read it: never use that prefix
# for a password, token or API key.
NEXT_PUBLIC_APP_NAME=Intern playground
